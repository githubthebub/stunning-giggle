{
  "name": "compass-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Compass — a deterministic, on-device personal-growth coaching app (no AI, no server).",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.jest.json",
    "sync:legal": "node scripts/syncLegal.mjs",
    "fix:vocab": "node scripts/normalizeContentVocab.mjs",
    "lint:content": "node scripts/lintContent.mjs"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "crypto-js": "^4.2.0",
    "expo": "~52.0.0",
    "expo-crypto": "~14.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.0.3",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.9.0",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.3.3"
  }
}
